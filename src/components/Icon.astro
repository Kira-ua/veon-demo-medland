---
// Line icons, 24px, 1.5px stroke, currentColor. Decorative: the parent control carries the name.
type Name = "phone" | "telegram" | "viber" | "search" | "menu" | "close" | "mail" | "pin" | "plus" | "check" | "copy";
interface Props { name: Name; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5.5 3.5h3l1.5 4-2 1.3a10.5 10.5 0 0 0 7.2 7.2l1.3-2 4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3.5 5.7a2 2 0 0 1 2-2.2Z" />}
  {name === "telegram" && <><path d="M21 4.5 2.8 11.4c-.7.3-.7 1.2 0 1.4l4.4 1.5 1.7 5.2c.2.6 1 .8 1.4.3l2.5-2.6 4.5 3.3c.5.4 1.3.1 1.4-.6L21.9 5.4c.1-.6-.4-1.1-.9-.9Z" /><path d="m7.2 14.3 9.6-6.3-6.4 7.2" /></>}
  {name === "viber" && <><path d="M12 2.8c4.9 0 8.2 2.4 8.2 7.9 0 5.4-3.3 7.8-8.2 7.8-.8 0-1.5 0-2.2-.2L6.3 21v-3.4c-1.7-1.3-2.5-3.5-2.5-6.9 0-5.5 3.3-7.9 8.2-7.9Z" /><path d="M9.3 7.6c.4-.4 1-.4 1.3 0l.8 1.1c.3.4.2.9-.1 1.2l-.4.4c.4 1 1.2 1.8 2.2 2.3l.4-.4c.3-.3.8-.4 1.2-.1l1.1.8c.4.3.4.9 0 1.3l-.5.5c-.6.6-1.6.7-2.4.3a8.6 8.6 0 0 1-4.1-4.1c-.4-.8-.2-1.7.4-2.4l.1-.9Z" /></>}
  {name === "search" && <><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></>}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></>}
  {name === "pin" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === "copy" && <><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></>}
</svg>
