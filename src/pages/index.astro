---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Napryamy from "../components/Napryamy.astro";
import Pidbir from "../components/Pidbir.astro";
import Umovy from "../components/Umovy.astro";
import Kontakty from "../components/Kontakty.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import { contacts } from "../data/site";

const title = "Медичне обладнання для лікарень, клінік і медцентрів | MedLand, Одеса";
const description = "Медичне обладнання для закладів: реанімація, ендоскопія, хірургія, ЛОР, кардіологія. Підбір моделі, рахунок ФОП, доставка Новою поштою по Україні.";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "Store"],
      name: "MedLand",
      description,
      telephone: "+380983006090",
      email: contacts.email,
      address: { "@type": "PostalAddress", streetAddress: "вул. Боровського 1/16", addressLocality: "Одеса", addressCountry: "UA" },
      openingHoursSpecification: [{ "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "10:00", closes: "17:00" }],
      paymentAccepted: "Картка ПриватБанку, картка monobank, рахунок ФОП",
      areaServed: "UA",
      sameAs: [contacts.telegram],
    },
    { "@type": "WebSite", name: "MedLand", inLanguage: "uk" },
  ],
};
---
<Base lang="uk" title={title} description={description} jsonLd={jsonLd}>
  <Header slot="header" />
  <Hero />
  <Napryamy />
  <Pidbir />
  <Umovy />
  <Kontakty />
  <Fragment slot="footer">
    <Footer />
    <MobileBar />
  </Fragment>
</Base>
<script src="../scripts/request.ts"></script>
<script src="../scripts/ui.ts"></script>
