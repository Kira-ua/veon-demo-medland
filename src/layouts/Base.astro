---
import "@fontsource-variable/geologica/wght.css";
import "@fontsource-variable/golos-text/wght.css";
import "../styles/tokens.css";
import "../styles/global.css";
import displayFont from "@fontsource-variable/geologica/files/geologica-cyrillic-wght-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; jsonLd?: object; }
const { lang, title, description, canonical, jsonLd } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#F4F6F9" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/"}favicon.png`} type="image/png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
    <style is:global>
      /* Repeated from global.css so the layout carries the Floor rule on its own (Hallmark gate 34). */
      html, body { overflow-x: clip; }
    </style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">До змісту</a>
    <slot name="header" />
    <main id="main" data-rec="W-R011"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
